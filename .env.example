# URL do projeto Supabase (painel > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase (seguro expor no browser; protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service role" do Supabase — NUNCA exponha no browser.
# Só necessária se alguma rota de servidor precisar ignorar RLS.
# Atualmente não é utilizada pelo SemioLab.
SUPABASE_SERVICE_ROLE_KEY=
