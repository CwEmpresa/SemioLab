# URL do projeto Supabase (painel > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase (seguro expor no browser; protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service role" do Supabase — NUNCA exponha no browser.
# Usada apenas em app/api/webhooks/cakto (grava assinatura/acesso Pro
# ignorando RLS, após validar o segredo do webhook).
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do webhook da Cakto (painel Cakto > Integrações > seu webhook > secret).
# Usado para validar que a requisição em POST /api/webhooks/cakto veio
# realmente da Cakto (comparação em tempo constante do campo "secret" do corpo).
CAKTO_WEBHOOK_SECRET=

# Provedor de IA ativo: "openai" (padrão) ou "gemini".
AI_PROVIDER=openai

# Modelo da OpenAI usado pelo Paciente IA.
OPENAI_MODEL=gpt-5-mini

# Chave da API da OpenAI (https://platform.openai.com/api-keys).
# NUNCA exponha no browser — usada apenas nas rotas server-side.
OPENAI_API_KEY=

# Chave da API do Google Gemini (https://aistudio.google.com/apikey).
# NUNCA exponha no browser — usada apenas nas rotas server-side da
# simulação de paciente-IA (app/api/patient/*).
GEMINI_API_KEY=
